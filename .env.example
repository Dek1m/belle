# Belle
SERVICE_NAME=belle
BELLE_HEALTH_PORT=8000
LOG_LEVEL=INFO
BELLE_MODULES_DIR=/app/mia/modules

# Очередь (важное для compose; остальное — дефолты модуля)
REDIS_HOST=redis
REDIS_PORT=6379
# WORKER_CONCURRENCY=  # пусто = число ядер

# База данных
# Runtime CRUD → pgbouncer:6432 (compose задаёт DB_HOST/DB_PORT).
# CREATE/DROP DATABASE → postgres:5432 (admin DSN, в обход pgbouncer).
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=belle
DB_USER=belle
DB_PASSWORD=CHANGE_ME
DB_ADMIN_HOST=postgres
DB_ADMIN_PORT=5432
# После деплоя pgbouncer на app-net: disable.
# Пока pgbouncer не поднят и ходим в postgres напрямую — require/verify-full как сейчас.
# Не prefer (уже обжигались).
DB_SSL_MODE=disable

# Auth (JWT)
AUTH_JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRATION_HOURS=24