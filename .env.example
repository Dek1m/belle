# Belle
SERVICE_NAME=belle
BELLE_HEALTH_PORT=8000
LOG_LEVEL=INFO
BELLE_MODULES_DIR=modules

# Очередь (важное для compose; остальное — дефолты модуля)
REDIS_HOST=redis
REDIS_PORT=6379
# WORKER_CONCURRENCY=  # пусто = число ядер

# База данных (сервис postgres из ~/app/postgres)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=belle
DB_USER=belle
DB_PASSWORD=CHANGE_ME

# Auth (JWT)
AUTH_JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRATION_HOURS=24