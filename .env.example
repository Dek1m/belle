# Belle
SERVICE_NAME=belle
BELLE_HEALTH_PORT=8000
LOG_LEVEL=INFO
BELLE_MODULES_DIR=/app/mia/modules

# Очередь (важное для compose; остальное — дефолты модуля)
REDIS_HOST=redis
REDIS_PORT=6379
# WORKER_CONCURRENCY=  # пусто = число ядер

# База данных
# Runtime CRUD → pgbouncer:6432 (compose задаёт DB_HOST/DB_PORT).
# CREATE/DROP DATABASE → postgres:5432 (admin DSN, в обход pgbouncer).
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=belle
DB_USER=belle
DB_PASSWORD=CHANGE_ME
DB_ADMIN_HOST=postgres
DB_ADMIN_PORT=5432
# После деплоя pgbouncer на app-net: disable.
# Пока pgbouncer не поднят и ходим в postgres напрямую — require/verify-full как сейчас.
# Не prefer (уже обжигались).
DB_SSL_MODE=disable

# Auth (JWT)
AUTH_JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
# AES-256-GCM for LLM provider API keys. Fallback: AUTH_JWT_SECRET.
LLM_SECRETS_KEY=CHANGE_ME_TO_RANDOM_64_CHARS
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRATION_HOURS=24

# Origin страницы albedo (не belle). CORS не открывать.
# Несколько — через запятую.
MIA_REST_SPA_ORIGINS=http://ai-t-01.atom.ui:5173
# HTTP-тест без TLS: false. HTTPS — true (__Host- cookies).
MIA_REST_COOKIE_SECURE=false
# Модули — discovery с ФС (ADR-005). Не задаём MIA_WORKER_MODULES и MIA_APIPROXY_WHITELIST.

# ── Tunables (Preferences). Секреты сюда не кладём. ──
# AUTH_JWT_ACCESS_EXPIRATION_MINUTES=15
# AUTH_PASSWORD_MIN_LENGTH=8
# AUTH_LOGIN_ATTEMPTS_LIMIT=5
# AUTH_PERMS_CACHE_TTL=300
# DB_POOL_MIN=1
# DB_POOL_MAX=2
# DB_CACHE_ENABLED=true
# MIA_REST_MAX_BODY_BYTES=1048576
# FS_MAX_WRITE_BYTES=10485760
# FS_DEFAULT_PAGE_SIZE=50
# NOTIFICATION_TTL_DAYS=30
# NOTIFICATION_POLL_HINT=30
# WORKSPACE_DEFAULT_PAGE_SIZE=50
# LLM_DEFAULT_TEMPERATURE=0.7
# LLM_DEFAULT_MAX_TOKENS=4096
# MIA_APIPROXY_METHOD_TIMEOUT=30
# MIA_LOG_FORMAT=posix